{
  "scenarios": [
    {
      "id": "basic",
      "name": "Cristian · 对称延迟下一次同步",
      "settings": {"nodeCount": 3, "latency": 100},
      "description": "node-2 快 1.8s、node-3 慢 1.2s。各同步一次：RTT≈200ms，误差降到几毫秒以内；随后漂移让误差重新增长。",
      "steps": [
        {"check": {"all": [{"node": "node-2", "path": "errorMs", "op": ">", "value": 1500}, {"node": "node-3", "path": "errorMs", "op": "<", "value": -900}]}, "label": "初始：node-2 快约 1.8s，node-3 慢约 1.2s"},
        {"input": {"node": "node-2", "method": "Application.Sync", "values": {"minMs": 0}}, "expect": "ok"},
        {"input": {"node": "node-3", "method": "Application.Sync", "values": {"minMs": 0}}, "expect": "ok"},
        {"check": {"node": ["node-2", "node-3"], "path": "lastSync.rttMs", "op": ">=", "value": 150}, "label": "客户端用自己的时钟测得 RTT ≈ 2×100ms"},
        {"check": {"node": ["node-2", "node-3"], "path": "lastSync.errorAfterMs", "op": "abs<=", "value": 45}, "label": "同步后误差 |error| ≤ 45ms"},
        {"check": {"node": ["node-2", "node-3"], "path": "lastSync.withinBound", "value": true}, "label": "误差在 ±(RTT/2 − min) 之内"},
        {"wait": 10000},
        {"check": {"all": [{"node": "node-2", "path": "errorMs", "op": ">=", "value": 120}, {"node": "node-3", "path": "errorMs", "op": "<=", "value": -90}]}, "label": "10s 后漂移（+20 / −15 ms/s）使误差重新增长"}
      ]
    },
    {
      "id": "asymmetric",
      "name": "Cristian · 非对称链路",
      "settings": {"nodeCount": 3, "latency": 100},
      "description": "node-2→node-1 的请求方向延迟 700ms，返回方向仍是 100ms。t + RTT/2 假设两个方向相等，误差 ≈ (700−100)/2 = +300ms，但仍落在 ±RTT/2 之内。",
      "steps": [
        {"fault": {"kind": "link", "from": "node-2", "to": "node-1", "latency": 700}},
        {"input": {"node": "node-2", "method": "Application.Sync", "values": {"minMs": 0}}, "expect": "ok"},
        {"input": {"node": "node-3", "method": "Application.Sync", "values": {"minMs": 0}}, "expect": "ok"},
        {"check": {"node": "node-2", "path": "lastSync.rttMs", "op": ">=", "value": 750}, "label": "node-2 的 RTT ≈ 700 + 100"},
        {"check": {"all": [{"node": "node-2", "path": "lastSync.errorAfterMs", "op": ">=", "value": 250}, {"node": "node-2", "path": "lastSync.errorAfterMs", "op": "<=", "value": 350}]}, "label": "node-2 同步后仍快 ≈ (d_req − d_resp)/2 = 300ms"},
        {"check": {"node": "node-2", "path": "lastSync.withinBound", "value": true}, "label": "但误差没有超出精度界 RTT/2"},
        {"check": {"node": "node-3", "path": "lastSync.errorAfterMs", "op": "abs<=", "value": 45}, "label": "对称链路上的 node-3 误差很小"}
      ]
    },
    {
      "id": "periodic",
      "name": "Cristian · 周期同步抑制漂移",
      "settings": {"nodeCount": 3, "latency": 100},
      "description": "node-2 每 3s 同步一次，误差呈锯齿形，峰值约为 漂移率×周期 ≈ 60ms；node-3 只同步一次，误差随时间线性增长。",
      "steps": [
        {"input": {"node": "node-3", "method": "Application.Sync", "values": {"minMs": 0}}, "expect": "ok"},
        {"input": {"node": "node-2", "method": "Application.AutoSync", "values": {"periodMs": 3000, "minMs": 0}}, "expect": "ok"},
        {"wait": 24000},
        {"check": {"node": "node-2", "path": "syncs", "op": ">=", "value": 6}, "label": "node-2 已周期同步多次"},
        {"check": {"node": "node-2", "path": "autoPeakMs", "op": "<=", "value": 110}, "label": "周期同步：误差峰值 ≤ 110ms（≈20ms/s × 3s）"},
        {"check": {"node": "node-3", "path": "errorMs", "op": "<=", "value": -250}, "label": "只同步一次的 node-3：24s 后误差已超过 250ms"}
      ]
    },
    {
      "id": "server-delay",
      "name": "Cristian · 服务器排队延迟",
      "settings": {"nodeCount": 3, "latency": 100},
      "description": "时间服务器繁忙，每个请求先排队 1000ms 再读时钟。Cristian 无法区分排队与网络延迟，RTT 变成 1200ms，客户端误差 ≈ +500ms；取消延迟后恢复准确。",
      "steps": [
        {"input": {"node": "node-1", "method": "Application.SetDelay", "values": {"delayMs": 1000}}, "expect": "ok"},
        {"input": {"node": "node-2", "method": "Application.Sync", "values": {"minMs": 0}}, "expect": "ok"},
        {"check": {"node": "node-2", "path": "lastSync.rttMs", "op": ">=", "value": 1150}, "label": "RTT 包含服务器排队时间 ≈ 1200ms"},
        {"check": {"all": [{"node": "node-2", "path": "lastSync.errorAfterMs", "op": ">=", "value": 440}, {"node": "node-2", "path": "lastSync.errorAfterMs", "op": "<=", "value": 560}]}, "label": "同步后误差 ≈ +delay/2 = +500ms"},
        {"check": {"node": "node-2", "path": "lastSync.withinBound", "value": true}, "label": "仍在精度界内，但精度界本身变成了 ±600ms"},
        {"input": {"node": "node-1", "method": "Application.SetDelay", "values": {"delayMs": 0}}, "expect": "ok"},
        {"input": {"node": "node-2", "method": "Application.Sync", "values": {"minMs": 0}}, "expect": "ok"},
        {"check": {"node": "node-2", "path": "lastSync.errorAfterMs", "op": "abs<=", "value": 45}, "label": "服务器空闲后再同步：误差回到 45ms 以内"}
      ]
    }
  ]
}
