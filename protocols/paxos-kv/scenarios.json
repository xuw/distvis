{
  "scenarios": [
    {
      "id": "sequential",
      "name": "kvpaxos · 不同服务器依次写入与读取",
      "settings": {"nodeCount": 5, "latency": 200},
      "description": "课件 p.54–55：Put 发往不同服务器，每个操作占一个日志槽位；在另一台服务器 Get 也写入日志，读到第 4 项之前的最新值。",
      "steps": [
        {"input": {"node": "node-1", "method": "Application.Put", "values": {"key": "a", "value": "1"}}, "expect": "ok"},
        {"input": {"node": "node-3", "method": "Application.Put", "values": {"key": "b", "value": "2"}}, "expect": "ok"},
        {"input": {"node": "node-5", "method": "Application.Put", "values": {"key": "a", "value": "3"}}, "expect": "ok"},
        {"note": "课件 p.55：在另一台服务器上读，Get 本身也占一个日志槽位"},
        {"input": {"node": "node-2", "method": "Application.Get", "values": {"key": "a"}}, "expect": "ok"},
        {"check": {"node": "node-2", "path": "lastResult", "value": "get a = 3 (slot 4)"}, "label": "Get 读到最新写入 a=3，位于日志第 4 项"},
        {"until": {"all": [{"same": "log"}, {"node": "*", "path": "appliedIndex", "value": 4}]}, "timeout": 10000, "label": "所有服务器日志相同且都执行到第 4 项"},
        {"check": {"node": "node-4", "path": "log", "value": ["1:put a=1", "2:put b=2", "3:put a=3", "4:get a"]}, "label": "日志内容与写入顺序一致"},
        {"check": {"same": "store"}, "label": "所有服务器存储相同"}
      ]
    },
    {
      "id": "concurrent",
      "name": "kvpaxos · 两个写入竞争同一槽位",
      "settings": {"nodeCount": 5, "latency": 300},
      "description": "node-1 与 node-2 同时 Put(x)，都提议槽位 1；槽位 1 只能选定一个，输的一方执行对方的操作后在槽位 2 重新提议，所有副本日志相同。",
      "steps": [
        {"input": {"node": "node-1", "method": "Application.Put", "values": {"key": "x", "value": "紫荆"}}, "await": false, "expect": "ok"},
        {"input": {"node": "node-2", "method": "Application.Put", "values": {"key": "x", "value": "澜园"}}, "await": false, "expect": "ok"},
        {"until": {"node": "*", "path": "appliedIndex", "value": 2}, "timeout": 15000, "label": "两个 Put 都已提交，所有服务器执行到第 2 项"},
        {"check": {"node": "any", "path": "conflicts", "value": 1, "op": ">="}, "label": "有一台服务器在槽位 1 输给对方，转到槽位 2 重新提议"},
        {"check": {"same": "log"}, "label": "所有服务器日志相同"},
        {"check": {"same": "store"}, "label": "所有服务器对 x 的最终值一致"},
        {"check": {"any": [{"node": "node-3", "path": "log", "value": ["1:put x=紫荆", "2:put x=澜园"]}, {"node": "node-3", "path": "log", "value": ["1:put x=澜园", "2:put x=紫荆"]}]}, "label": "两个写入各占一个槽位"}
      ]
    },
    {
      "id": "crash-catchup",
      "name": "kvpaxos · 少数节点崩溃与恢复追赶",
      "settings": {"nodeCount": 5, "latency": 200},
      "description": "课件 p.56：node-5 参与第 1 项后崩溃，多数派继续提交；恢复后它从持久化的 Paxos 状态（日志与承诺）重启，并对缺失槽位运行 Paxos 找回已选定的操作。",
      "steps": [
        {"input": {"node": "node-5", "method": "Application.Put", "values": {"key": "z", "value": "0"}}, "expect": "ok"},
        {"until": {"all": [{"same": "log"}, {"node": "*", "path": "appliedIndex", "value": 1}]}, "timeout": 8000, "label": "崩溃前 node-5 已参与第 1 项"},
        {"fault": {"kind": "crash", "node": "node-5"}},
        {"input": {"node": "node-1", "method": "Application.Put", "values": {"key": "a", "value": "1"}}, "expect": "ok"},
        {"input": {"node": "node-2", "method": "Application.Put", "values": {"key": "b", "value": "2"}}, "expect": "ok"},
        {"input": {"node": "node-3", "method": "Application.Put", "values": {"key": "c", "value": "3"}}, "expect": "ok"},
        {"until": {"all": [{"same": "log"}, {"node": "*", "path": "appliedIndex", "value": 4}]}, "timeout": 8000, "label": "node-5 崩溃时，其余 4 台（多数派）照常提交"},
        {"fault": {"kind": "recover", "node": "node-5"}},
        {"until": {"node": "node-5", "path": "recovered", "value": true}, "timeout": 30000, "label": "node-5 重启完成"},
        {"check": {"node": "node-5", "path": "appliedIndex", "value": 1}, "label": "node-5 错过了崩溃期间的 3 个槽位"},
        {"note": "新的写入经过 node-5 时，它发现自己落后，对缺失的槽位运行 Paxos（no-op 提议）找回已选定的值"},
        {"input": {"node": "node-1", "method": "Application.Put", "values": {"key": "d", "value": "4"}}, "expect": "ok"},
        {"until": {"all": [{"same": "log"}, {"node": "*", "path": "appliedIndex", "value": 5}]}, "timeout": 15000, "label": "node-5 追上：日志相同，执行到第 5 项"},
        {"check": {"same": "store"}, "label": "node-5 的存储与其他服务器一致"},
        {"check": {"node": "node-5", "path": "log", "value": ["1:put z=0", "2:put a=1", "3:put b=2", "4:put c=3", "5:put d=4"]}, "label": "追赶得到的是已选定的值，不是 no-op"}
      ]
    },
    {
      "id": "partition",
      "name": "kvpaxos · 少数派分区无法提交",
      "settings": {"nodeCount": 5, "latency": 200},
      "description": "CP：{node-4, node-5} 被分区后 Put 超时失败，多数派一侧仍可写入；分区恢复后少数派追上同一日志。",
      "steps": [
        {"note": "分区：{node-4, node-5} 与 {node-1, node-2, node-3} 互相不通"},
        {"fault": {"kind": "link", "from": "node-4", "to": "node-1", "blocked": true, "bidirectional": true}},
        {"fault": {"kind": "link", "from": "node-4", "to": "node-2", "blocked": true, "bidirectional": true}},
        {"fault": {"kind": "link", "from": "node-4", "to": "node-3", "blocked": true, "bidirectional": true}},
        {"fault": {"kind": "link", "from": "node-5", "to": "node-1", "blocked": true, "bidirectional": true}},
        {"fault": {"kind": "link", "from": "node-5", "to": "node-2", "blocked": true, "bidirectional": true}},
        {"fault": {"kind": "link", "from": "node-5", "to": "node-3", "blocked": true, "bidirectional": true}},
        {"input": {"node": "node-4", "method": "Application.Put", "values": {"key": "k", "value": "少数派"}}, "expect": "error", "timeout": 15000},
        {"check": {"node": "node-4", "path": "lastResult", "value": "失败", "op": "includes"}, "label": "少数派得不到多数派 Promise，Put 超时失败"},
        {"input": {"node": "node-1", "method": "Application.Put", "values": {"key": "k", "value": "多数派"}}, "expect": "ok"},
        {"until": {"all": [{"same": "log", "nodes": ["node-1", "node-2", "node-3"]}, {"node": "node-1", "path": "appliedIndex", "value": 1}]}, "timeout": 8000, "label": "多数派一侧照常提交"},
        {"check": {"all": [{"node": "node-4", "path": "appliedIndex", "value": 0}, {"node": "node-5", "path": "appliedIndex", "value": 0}]}, "label": "少数派一侧没有任何提交"},
        {"fault": {"kind": "heal"}},
        {"input": {"node": "node-2", "method": "Application.Put", "values": {"key": "m", "value": "2"}}, "expect": "ok"},
        {"until": {"all": [{"same": "log"}, {"node": "*", "path": "appliedIndex", "value": 2}]}, "timeout": 15000, "label": "分区恢复后少数派追上"},
        {"check": {"node": "node-5", "path": "store.k", "value": "多数派"}, "label": "少数派失败的写入没有出现"}
      ]
    }
  ]
}
